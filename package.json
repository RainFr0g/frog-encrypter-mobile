{
	"name": "frog-encrypter",
	"version": "1.0.3",
	"description": "Encrypt text fragments, notes, and files inside and outside your Obsidian vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"author": "RainFr0g",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.20.1",
		"@types/pako": "^2.0.4",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@codemirror/language": "6.11.0",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"pako": "^3.0.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
